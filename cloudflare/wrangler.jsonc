{
  "name": "easysub-worker",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../frontend/dist-android-preview",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/login", "/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "easysub", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["0,15,30,45 1 * * *"] }
}
