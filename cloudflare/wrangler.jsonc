{
  "name": "easysub-worker",
  "keep_vars": true,
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../frontend/dist-android-preview",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/login", "/dashboard", "/subscriptions", "/calendar", "/reports", "/notifications", "/logs", "/settings", "/api/*"]
  },
  "d1_databases": [
  {
    "binding": "DB",
    "database_name": "easysub",
    "database_id": "18b1a0a9-ac80-45f9-a8f7-1e0449945b38",
    "migrations_dir": "migrations"
  }
],
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
